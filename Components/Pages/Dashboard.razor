@page "/dashboard"
@rendermode InteractiveServer

<PageTitle>ReqClub - Dashboard</PageTitle>

<div class="min-h-screen bg-[#f2f5fa] bg-bottom bg-fixed bg-no-repeat bg-contain font-sans flex flex-col" style="background-image: url('/images/dashboard-background.png');">
    
    <!-- Top Navigation Bar -->
    <nav class="flex justify-between items-center bg-white/95 backdrop-blur-md px-6 py-4 md:px-12 shadow-sm sticky top-0 z-20 border-b border-gray-100">
        <div class="text-[26px] font-black text-[#111] tracking-[1.5px] scale-x-[1.1] origin-left">
            REQCLUB
        </div>
        
        <div class="flex items-center gap-5">
            <button type="button" class="w-10 h-10 rounded-full flex items-center justify-center text-[#333] hover:bg-gray-100 transition-colors">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
            </button>
            <button type="button" class="w-10 h-10 rounded-full flex items-center justify-center text-[#333] hover:bg-gray-100 transition-colors">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                    <path d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                </svg>
            </button>
            <a href="/" class="text-sm font-bold text-gray-700 hover:text-red-600 transition-colors ml-2">
                Logout
            </a>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="grow px-4 py-8 md:px-8 flex justify-center">
        <div class="w-full max-w-2xl flex flex-col">
            
            <!-- Clean Header Section (No Community Badge) -->
            <div class="mb-6">
                <h1 class="text-3xl font-extrabold tracking-tight text-gray-900">
                    Welcome back, <span class="text-[#6C63FF]">User</span> 👋
                </h1>
                <p class="text-sm text-gray-500 mt-1">Here is what is happening today.</p>
            </div>

            <!-- Compact Inline Post Creator -->
            <div class="bg-white rounded-[24px] p-3 shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex items-center gap-3">
                    <!-- Creator Circle Avatar -->
                    <div class="w-10 h-10 min-w-10 rounded-full shrink-0 aspect-square bg-[#6C63FF] text-white font-bold flex items-center justify-center shadow-sm">
                        U
                    </div>
                    
                    <input @bind="newPostContent" 
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           type="text" 
                           placeholder="Share an update or idea..." 
                           class="grow bg-[#f4f7fb] hover:bg-[#eef2f8] focus:bg-white text-[14px] text-gray-800 placeholder-gray-400 px-4 py-2.5 rounded-full border border-transparent focus:border-[#6C63FF]/30 focus:ring-4 focus:ring-[#6C63FF]/10 focus:outline-none transition-all" />
                    
                    <button @onclick="SubmitPost" 
                            disabled="@(string.IsNullOrWhiteSpace(newPostContent))"
                            class="bg-[#6C63FF] disabled:opacity-40 disabled:cursor-not-allowed hover:bg-[#5A50E6] active:scale-95 text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-all shrink-0 flex items-center gap-1.5 shadow-sm">
                        <span>Post</span>
                        <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                            <path d="M3.105 2.289a.75.75 0 00-.826.95l1.414 4.925A1.5 1.5 0 004.835 9.25h4.915a.75.75 0 010 1.5H4.835a1.5 1.5 0 00-1.142 1.086l-1.414 4.926a.75.75 0 00.826.95 28.896 28.896 0 0015.293-7.154.75.75 0 000-1.115A28.897 28.897 0 003.105 2.289z" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Feed Stream with Spacing Below Post Area -->
            <div class="mt-8 flex flex-col gap-4 pb-24">
                @if (!feedPosts.Any())
                {
                    <div class="text-center py-16 px-6 bg-white/70 backdrop-blur-sm rounded-[24px] border border-dashed border-gray-200">
                        <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3 text-gray-400">
                            💬
                        </div>
                        <p class="text-gray-600 font-medium text-sm">No updates in your feed yet.</p>
                        <p class="text-gray-400 text-xs mt-1">Start the conversation by posting above!</p>
                    </div>
                }
                else
                {
                    @foreach (var post in feedPosts)
                    {
                        <!-- Round Post Card -->
                        <article class="bg-white rounded-[24px] p-5 shadow-sm border border-gray-100/80 hover:shadow-md transition-all">
                            <!-- Author Row -->
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <!-- Circular Profile Icon -->
                                    <div class="w-10 h-10 min-w-10 rounded-full shrink-0 aspect-square bg-[#6C63FF] text-white font-bold text-sm flex items-center justify-center shadow-sm">
                                        @post.Author.Substring(0, 1)
                                    </div>
                                    <div>
                                        <h2 class="text-sm font-bold text-gray-900 leading-tight m-0">@post.Author</h2>
                                        <span class="text-[11px] text-gray-400 font-normal">@FormatTime(post.Timestamp)</span>
                                    </div>
                                </div>
                                <span class="text-gray-300 text-xs">•••</span>
                            </div>

                            <!-- Post Body -->
                            <p class="text-gray-700 text-[14px] leading-relaxed break-words pl-[52px] whitespace-pre-line m-0">@post.Content</p>
                        </article>
                    }
                }
            </div>
            
        </div>
    </main>
</div>

@code {
    private string newPostContent = "";
    private List<PostModel> feedPosts = new();

    protected override void OnInitialized()
    {
        feedPosts.Add(new PostModel { 
            Author = "User",
            Content = "Just setting up my new dashboard. The Tailwind layout is coming together perfectly!", 
            Timestamp = DateTime.Now.AddMinutes(-45) 
        });
        feedPosts.Add(new PostModel { 
            Author = "Alex",
            Content = "Hello ReqClub! Excited to test out this new interface.", 
            Timestamp = DateTime.Now.AddHours(-2) 
        });
    }

    private void SubmitPost()
    {
        if (string.IsNullOrWhiteSpace(newPostContent)) return;

        feedPosts.Insert(0, new PostModel
        {
            Author = "User",
            Content = newPostContent.Trim(),
            Timestamp = DateTime.Now
        });

        newPostContent = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SubmitPost();
        }
    }

    private string FormatTime(DateTime time)
    {
        var span = DateTime.Now - time;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return time.ToString("MMM d");
    }

    public class PostModel
    {
        public string Author { get; set; } = "User";
        public string Content { get; set; } = "";
        public DateTime Timestamp { get; set; }
    }
}